---
import Monograma from './Monograma.astro';
import { grupo } from '../data/grupo.ts';

const links = [
  { href: '/#grupo', label: 'El grupo' },
  { href: '/#comercios', label: 'Comercios' },
  { href: '/club', label: 'Club Aponte Rivera' },
  { href: '/#contacto', label: 'Contacto' },
];
---

<header
  class="sticky top-0 z-50 border-b border-white/5 bg-noche-900/80 backdrop-blur-md"
>
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6"
    aria-label="Principal"
  >
    <a href="/" class="flex items-center gap-3" aria-label={`Inicio · ${grupo.nombre}`}>
      <Monograma class="h-10 w-10 text-lg" />
      <span class="hidden font-display text-lg font-semibold text-ink-1 sm:block">
        Grupo Aponte Rivera
      </span>
    </a>

    <div class="hidden items-center gap-7 md:flex">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="text-sm text-ink-2 transition-colors hover:text-oro-300"
          >
            {l.label}
          </a>
        ))
      }
      <a
        href={grupo.urlClubApp}
        class="rounded-full bg-oro-400 px-4 py-2 text-sm font-semibold text-noche-900 transition-colors hover:bg-oro-300"
      >
        Ingresar al Club
      </a>
    </div>

    <details class="group relative md:hidden">
      <summary
        class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-lg text-ink-1 ring-1 ring-white/10 [&::-webkit-details-marker]:hidden"
        aria-label="Abrir menú"
      >
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </summary>
      <div
        class="absolute right-0 mt-2 w-56 rounded-xl border border-white/10 bg-noche-900 p-2 shadow-2xl"
      >
        {
          links.map((l) => (
            <a
              href={l.href}
              class="block rounded-lg px-3 py-3 text-sm text-ink-2 hover:bg-white/5 hover:text-ink-1"
            >
              {l.label}
            </a>
          ))
        }
        <a
          href={grupo.urlClubApp}
          class="mt-1 block rounded-lg bg-oro-400 px-3 py-3 text-center text-sm font-semibold text-noche-900"
        >
          Ingresar al Club
        </a>
      </div>
    </details>
  </nav>
</header>
