---
import Monograma from './Monograma.astro';
import { grupo } from '../data/grupo.ts';

const year = new Date().getFullYear();
---

<footer id="contacto" class="border-t border-white/5 bg-noche-950">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <div class="flex items-center gap-3">
          <Monograma class="h-11 w-11 text-xl" />
          <span class="font-display text-lg font-semibold text-ink-1">Grupo Aponte Rivera</span>
        </div>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-ink-3">
          Un grupo de comercios unidos por una misma forma de atender: cercana,
          cuidada y para quedarse.
        </p>
      </div>

      <div>
        <h3 class="font-display text-sm font-semibold uppercase tracking-wider text-oro-300">
          Navega
        </h3>
        <ul class="mt-4 space-y-2 text-sm text-ink-2">
          <li><a class="hover:text-oro-300" href="/#grupo">El grupo</a></li>
          <li><a class="hover:text-oro-300" href="/#comercios">Comercios</a></li>
          <li><a class="hover:text-oro-300" href="/club">Club Aponte Rivera</a></li>
        </ul>
      </div>

      <div>
        <h3 class="font-display text-sm font-semibold uppercase tracking-wider text-oro-300">
          Club
        </h3>
        <ul class="mt-4 space-y-2 text-sm text-ink-2">
          <li><a class="hover:text-oro-300" href={grupo.urlClubApp}>Ingresar al Club</a></li>
          <li><a class="hover:text-oro-300" href="/club#membresia">Membresía Diamante</a></li>
          <li><a class="hover:text-oro-300" href={`mailto:${grupo.email}`}>{grupo.email}</a></li>
        </ul>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-2 border-t border-white/5 pt-6 text-xs text-ink-3 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} Grupo Aponte Rivera. Todos los derechos reservados.</p>
      <p>Hecho en Colombia.</p>
    </div>
  </div>
</footer>
