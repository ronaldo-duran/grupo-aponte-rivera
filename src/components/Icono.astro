---
// Íconos de línea (stroke) para las categorías de comercio. Sin dependencias.
interface Props {
  nombre: 'restaurante' | 'heladeria' | 'cerveceria' | 'colegio' | 'inmobiliaria';
  class?: string;
}
const { nombre, class: className = 'h-7 w-7' } = Astro.props;

const paths: Record<Props['nombre'], string> = {
  restaurante: 'M5 3v8m0 0a2 2 0 0 0 2-2V3m-4 0v6m0 2v10M16 3c-1.5 1-2 3-2 6 0 2 1 3 2 3v9',
  heladeria: 'M8 10a4 4 0 1 1 8 0M7 10h10l-5 11z',
  cerveceria: 'M6 8h9v11a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2zm9 2h2a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2h-2M9 5V3m3 2V3',
  colegio: 'M3 9l9-5 9 5-9 5zM7 11v5c0 1 2 2 5 2s5-1 5-2v-5',
  inmobiliaria: 'M4 11l8-6 8 6M6 10v9h12v-9M10 19v-5h4v5',
};
---

<svg
  class:list={[className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={paths[nombre]} />
</svg>
